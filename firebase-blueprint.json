{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User account information and fitness goals",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "fullName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phoneNumber": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email"]
    },
    "Booking": {
      "title": "Class Booking",
      "description": "Reservation for a fitness session",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "sessionId": { "type": "string" },
        "time": { "type": "string" },
        "status": { "type": "string", "enum": ["confirmed", "cancelled", "attended"] },
        "bookedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "sessionId", "time", "status", "bookedAt"]
    },
    "ContactMessage": {
      "title": "Contact Form Message",
      "description": "Messages sent via the contact form",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "message": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "email", "message", "timestamp"]
    },
    "Review": {
      "title": "User Review",
      "description": "Public feedback from members",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "rating": { "type": "number", "minimum": 1, "maximum": 5 },
        "comment": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "userName", "rating", "comment", "timestamp"]
    },
    "Service": {
      "title": "Fitness Program",
      "description": "Details about a specific class or training program",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "duration": { "type": "string" },
        "level": { "type": "string" },
        "image": { "type": "string" },
        "description": { "type": "string" },
        "fullDescription": { "type": "string" },
        "benefits": { "type": "array" },
        "whoIsItFor": { "type": "string" }
      }
    },
    "Trainer": {
      "title": "Elite Trainer",
      "description": "Professional coach profile",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "specialty": { "type": "string" },
        "experience": { "type": "string" },
        "image": { "type": "string" },
        "bio": { "type": "string" },
        "socials": { "type": "object" }
      }
    },
    "Schedule": {
      "title": "Class Session",
      "description": "A specific instance of a class in the schedule",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "serviceId": { "type": "string" },
        "trainerId": { "type": "string" },
        "day": { "type": "string" },
        "startTime": { "type": "string" },
        "endTime": { "type": "string" },
        "availableSlots": { "type": "number" },
        "totalSlots": { "type": "number" }
      }
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "User",
      "description": "Individual user profile documents"
    },
    "bookings/{bookingId}": {
      "schema": "Booking",
      "description": "Session reservations"
    },
    "contacts/{contactId}": {
      "schema": "ContactMessage",
      "description": "User inquiries"
    },
    "reviews/{reviewId}": {
      "schema": "Review",
      "description": "Public member feedback"
    },
    "services/{serviceId}": {
      "schema": "Service",
      "description": "Fitness program definitions"
    },
    "trainers/{trainerId}": {
      "schema": "Trainer",
      "description": "Coach profiles"
    },
    "schedules/{scheduleId}": {
      "schema": "Schedule",
      "description": "Weekly class timetable"
    }
  }
}
