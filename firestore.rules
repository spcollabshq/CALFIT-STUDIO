rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // global helpers
    function isSignedIn() { return request.auth != null; }
    function isVerified() { return isSignedIn() && request.auth.token.email_verified == true; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    
    // User Profile Validation
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'fullName', 'createdAt', 'updatedAt']) &&
             data.keys().size() >= 5 &&
             data.uid is string && data.uid == request.auth.uid &&
             data.email is string && data.email.size() < 256 &&
             data.fullName is string && data.fullName.size() < 128 &&
             data.createdAt == request.time &&
             data.updatedAt == request.time;
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && 
                      incoming().uid == existing().uid &&
                      incoming().createdAt == existing().createdAt &&
                      incoming().updatedAt == request.time &&
                      incoming().diff(existing()).affectedKeys().hasOnly(['fullName', 'updatedAt', 'phoneNumber']);
    }

    // Contact Message Validation
    function isValidContactMessage(data) {
      return data.keys().hasAll(['name', 'email', 'message', 'timestamp']) &&
             data.keys().size() == 4 &&
             data.name is string && data.name.size() < 128 &&
             data.email is string && data.email.size() < 256 &&
             data.message is string && data.message.size() < 2000 &&
             data.timestamp == request.time;
    }

    match /contacts/{contactId} {
      allow create: if isValidContactMessage(incoming());
    }

    // Bookings Validation
    function isValidBooking(data) {
      return data.keys().hasAll(['userId', 'sessionId', 'status', 'bookedAt', 'time']) &&
             data.keys().size() >= 5 &&
             data.userId == request.auth.uid &&
             data.sessionId is string &&
             data.time is string && data.time.matches('^(0[1-9]|1[0-2]):[0-5][0-9] (AM|PM)$') &&
             data.status in ['confirmed', 'cancelled', 'attended'] &&
             data.bookedAt is timestamp;
    }

    match /bookings/{bookingId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isVerified() && isValidBooking(incoming()) && incoming().bookedAt == request.time;
      allow update: if isVerified() && isOwner(resource.data.userId) &&
                      incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) &&
                      incoming().status in ['confirmed', 'cancelled'] &&
                      incoming().updatedAt == request.time;
      allow delete: if isVerified() && isOwner(resource.data.userId) && resource.data.status == 'cancelled';
    }

    // Review Validation
    function isValidReview(data) {
      return data.keys().hasAll(['userId', 'userName', 'rating', 'comment', 'timestamp']) &&
             data.keys().size() == 5 &&
             data.userId == request.auth.uid &&
             data.userName is string &&
             data.rating is number && data.rating >= 1 && data.rating <= 5 &&
             data.comment is string && data.comment.size() < 2000 &&
             data.timestamp == request.time;
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isVerified() && isValidReview(incoming());
      allow update: if isVerified() && isOwner(resource.data.userId) && 
                      incoming().diff(existing()).affectedKeys().hasOnly(['rating', 'comment', 'timestamp']) &&
                      isValidReview(incoming());
      allow delete: if isVerified() && isOwner(resource.data.userId);
    }
  }
}
